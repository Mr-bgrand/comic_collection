{
  "name": "comic-collection",
  "version": "1.0.0",
  "description": "CGC-graded comic bin inventory: cert lookup, print labels, and a QR-linked catalog",
  "type": "module",
  "scripts": {
    "vault": "node src/import-vault.js",
    "psa:certs": "node src/import-psa-cert.js",
    "tag": "node src/import-tag.js",
    "tag:values": "node src/refresh-tag-values.js",
    "cgc:cards": "node src/import-cgc-cards.js",
    "arena:import": "node src/import-arena-club.js",
    "cards:images": "node src/import-card-images.js",
    "authority:import": "node src/import-authority.js",
    "review:build": "node docs/prototypes/build-engine.mjs",
    "value:history": "node src/value-history.js --seed-git",
    "lab": "node src/lab-server.js",
    "test": "node --test \"src/**/*.test.js\" \"docs/prototypes/*.test.mjs\"",
    "lookup": "node src/scrape.js",
    "repair": "node src/rerepair.js",
    "login": "node src/gocollect.js --login",
    "login:cgc": "node src/cgc-login.js",
    "scan:voice": "node src/scan.js --voice",
    "scan:timed": "node src/scan.js --timed 8",
    "scan:raw": "node src/scan-raw.js",
    "recrop": "node src/recrop.js",
    "fmv": "node src/gocollect.js",
    "build": "node src/build.js && node docs/prototypes/build-engine.mjs",
    "print": "node src/print.js",
    "edit": "node src/editor.js",
    "verify:print": "node src/verify-print.js",
    "export": "node src/export-lookup.js",
    "images": "node src/refetch-images.js",
    "images:import": "node src/import-images.js",
    "scan": "node src/scan.js",
    "prices": "node src/import-prices.js",
    "add": "node src/add-comic.js"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "playwright": "^1.49.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
