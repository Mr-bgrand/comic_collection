# Copy to .env and fill in. .env is gitignored; this template is not and must
# never contain real values.
#
# Credentials are optional. `npm run login` signs in by hand once and the session
# persists in the browser profile, which needs no password stored anywhere. Set
# these only if you want unattended refreshes to re-authenticate on their own.

GOCOLLECT_EMAIL=you@example.com
GOCOLLECT_PASSWORD=
