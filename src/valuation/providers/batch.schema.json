{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Copy-scoped valuation import",
  "type":"object",
  "required":["schemaVersion","edits"],
  "properties":{
    "schemaVersion":{"const":1},
    "edits":{"type":"array","items":{
      "type":"object","additionalProperties":false,
      "required":["copyId","revision","observations"],
      "properties":{
        "copyId":{"type":"string","minLength":1},
        "revision":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "observations":{"type":"array","minItems":1,"items":{
          "type":"object",
          "required":["id","copyId","basis","value","currency","source","match","reviewStatus"],
          "properties":{
            "id":{"type":"string","minLength":1},"copyId":{"type":"string","minLength":1},
            "basis":{"enum":["guide","sold-comps","psa-comparison","owner","raw-reference"]},
            "value":{"type":"number","minimum":0},"currency":{"const":"USD"},
            "evidenceKind":{"enum":["guide","sold-comps"]},"saleCount":{"type":"integer","minimum":1},
            "source":{"type":"object","required":["name","url","asOf","retrievedAt"],"properties":{
              "name":{"type":"string","minLength":1},"url":{"type":"string","format":"uri","pattern":"^https://"},
              "asOf":{"type":["string","null"]},"retrievedAt":{"type":"string"}
            }},
            "match":{"type":"object","required":["identity","grade","grader","condition","status"],"properties":{
              "identity":{"type":"object"},"grade":{"type":["number","string","null"]},"grader":{"type":["string","null"]},
              "condition":{"type":["string","object","null"]},"status":{"enum":["exact","ambiguous","mismatch","unknown"]}
            }},
            "reviewStatus":{"enum":["pending","accepted","rejected"]}
          }
        }}
      }
    }}
  }
}
